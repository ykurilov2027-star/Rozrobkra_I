# Скопіюйте цей файл у .env. Секретів тут немає — але й у репозиторій
# .env не потрапляє, як і в попередніх роботах: він ваш і локальний.

# Модель ембедінгів: ідентифікатор на Hugging Face Hub. Значення —
# відправна точка. Змінивши модель, перебудуйте індекс: вектори різних
# моделей непорівнянні.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Скільки результатів повертати за замовчуванням.
SEARCH_TOP_K=5

# Поріг схожості для семантичного пошуку: результати з меншою оцінкою
# відкидаються. 0.81 відсікає тестовий позаколекційний top-1 (0.802);
# повторно калібруйте його після зміни моделі або колекції.
SIMILARITY_THRESHOLD=0.81

# Параметри поділу на фрагменти. У чому їх рахувати і як застосовувати —
# ваше рішення; це лише спосіб не зашивати числа в код.
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Альтернатива локальній моделі — ембедінги через API того самого
# OpenAI-сумісного ендпоінта, що в ПР3 (потрібен ваш ключ). Тоді модуль
# embeddings.py викликає client.embeddings.create замість локальної моделі.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
